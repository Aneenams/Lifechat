# API call for send connection request
###
POST http://127.0.0.1:8000/connection/send 
Content-Type: application/json
Authorization: Token {{token}}

{
    "to_user_id":9
}

# API call for get pending request
###
GET http://127.0.0.1:8000/connection/pending
Authorization:Token {{token}}


# API call for accept pending request
###
POST http://127.0.0.1:8000/connection/accept/4
Authorization:Token {{token}}

# API call for view connections
###
GET  http://127.0.0.1:8000/connection/myconnections
Authorization: Token {{token}}


# API call for profile view
###
GET  http://127.0.0.1:8000/profile/my
Authorization: Token {{token}}

# Api call for update profile
###
PATCH http://127.0.0.1:8000/profile/my
Authorization: Token {{token}}
Content-Type: application/json

{
    "city":"kochi",
    "blood_status":"available"
}

# API call for search blood
###
GET http://127.0.0.1:8000/directory/search?blood_group=A+&city=Kochi
Authorization: Token {{token}}